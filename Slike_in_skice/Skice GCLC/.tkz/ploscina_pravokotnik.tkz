\begin{tikzpicture}
\clip (0,0) rectangle (14.000000,10.000000);
{\footnotesize

% Changing color 215 183 183
\definecolor{r215g183b183}{rgb}{0.843137,0.717647,0.717647}%
\color{r215g183b183}% 

% Filling rectangle left-bottom: A right-top: C
\fill (1.500000,1.500000) -- (6.000000,1.500000) -- (6.000000,4.500000) -- (1.500000,4.500000);%

% Changing color 0 0 0
\definecolor{r0g0b0}{rgb}{0.000000,0.000000,0.000000}%
\color{r0g0b0}% 

% Drawing segment A B
\draw [line width=0.032cm] (1.540000,1.500000) -- (5.960000,1.500000);%

% Drawing segment B C
\draw [line width=0.032cm] (6.000000,1.540000) -- (6.000000,4.460000);%

% Drawing segment C D
\draw [line width=0.032cm] (5.960000,4.500000) -- (1.540000,4.500000);%

% Drawing segment A D
\draw [line width=0.032cm] (1.500000,1.540000) -- (1.500000,4.460000);%

% Marking point A by circle
\draw [line width=0.032cm] (1.500000,1.500000) circle (0.040000);%
\draw (1.530000,1.530000) node [anchor=north east] { $A$ };%

% Marking point B by circle
\draw [line width=0.032cm] (6.000000,1.500000) circle (0.040000);%
\draw (5.970000,1.530000) node [anchor=north west] { $B$ };%

% Marking point C by circle
\draw [line width=0.032cm] (6.000000,4.500000) circle (0.040000);%
\draw (5.970000,4.470000) node [anchor=south west] { $C$ };%

% Marking point D by circle
\draw [line width=0.032cm] (1.500000,4.500000) circle (0.040000);%
\draw (1.530000,4.470000) node [anchor=south east] { $D$ };%

% Marking point a
\draw (3.750000,1.500000) node [anchor=north] { $a$ };%

% Marking point b
\draw (6.000000,3.000000) node [anchor=west] { $b$ };%
\color{black}
}
\end{tikzpicture}
