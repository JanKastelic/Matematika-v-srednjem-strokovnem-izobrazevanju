\begin{tikzpicture}
\clip (0,0) rectangle (14.000000,10.000000);
{\footnotesize

% Changing color 215 183 183
\definecolor{r215g183b183}{rgb}{0.843137,0.717647,0.717647}%
\color{r215g183b183}% 

% Filling triangle A B C
\fill (1.500000,3.000000) -- (5.500000,3.000000) -- (2.500000,4.800000);%

% Changing color 0 0 0
\definecolor{r0g0b0}{rgb}{0.000000,0.000000,0.000000}%
\color{r0g0b0}% 

% Drawing segment C' B
\draw [line width=0.016cm] (4.519426,1.234966) -- (5.480574,2.965034);%

% Drawing segment C' A
\draw [line width=0.016cm] (4.465700,1.220580) -- (1.534300,2.979420);%

% Marking point C' by circle
\draw [line width=0.016cm] (4.500000,1.200000) circle (0.040000);%
\draw (4.500000,1.200000) node [anchor=north] { $C'$ };%

% Drawing segment A B
\draw [line width=0.032cm] (1.540000,3.000000) -- (5.460000,3.000000);%

% Drawing segment B C
\draw [line width=0.032cm] (5.465700,3.020580) -- (2.534300,4.779420);%

% Drawing segment C A
\draw [line width=0.032cm] (2.480574,4.765034) -- (1.519426,3.034966);%

% Marking point A by circle
\draw [line width=0.032cm] (1.500000,3.000000) circle (0.040000);%
\draw (1.500000,3.000000) node [anchor=east] { $A$ };%

% Marking point B by circle
\draw [line width=0.032cm] (5.500000,3.000000) circle (0.040000);%
\draw (5.500000,3.000000) node [anchor=west] { $B$ };%

% Marking point C by circle
\draw [line width=0.032cm] (2.500000,4.800000) circle (0.040000);%
\draw (2.500000,4.800000) node [anchor=south] { $C$ };%

% Marking point a
\draw (4.000000,3.900000) node [anchor=south west] { $a$ };%

% Marking point b
\draw (2.000000,3.900000) node [anchor=south east] { $b$ };%

% Marking point c
\draw (3.500000,3.000000) node [anchor=north] { $c$ };%
\color{black}
}
