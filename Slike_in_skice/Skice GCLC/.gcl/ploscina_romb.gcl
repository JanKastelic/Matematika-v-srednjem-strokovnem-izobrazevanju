area 10 10 80 50

point A 15 15
point B 45 15
point C 55 44
point D 25 44

point A' 25 15
point C' 45 44
point B' 55 15

color 215 183 183
fillrectangle A' C'
filltriangle B C C'

color 183 215 183
filltriangle A A' D
filltriangle B B' C

color 0 0 0 

drawsegment D A'
drawsegment B B'
drawsegment B' C

drawsegment A C
drawsegment B D

cmark_b A'
cmark_rb B'

double
drawsegment A B
drawsegment B C
drawsegment C D
drawsegment A D

cmark_lb A
cmark_b B
cmark_rt C
cmark_lt D

midpoint a A B
mark_b a
midpoint a B C
mark_l a
midpoint v D A'
mark_r v
point \alpha 16 15
mark_rt \alpha
midpoint ee A C
midpoint e ee C
mark_lt e
midpoint ff D B
midpoint f ff B
mark_rt f