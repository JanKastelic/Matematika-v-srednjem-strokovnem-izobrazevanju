\begin{tikzpicture}
\clip (0,0) rectangle (14.000000,10.000000);
{\footnotesize

% Changing color 215 183 183
\definecolor{r215g183b183}{rgb}{0.843137,0.717647,0.717647}%
\color{r215g183b183}% 

% Filling rectangle left-bottom: A' right-top: C
\fill (3.000000,1.500000) -- (5.500000,1.500000) -- (5.500000,4.500000) -- (3.000000,4.500000);%

% Filling triangle B B' C
\fill (6.000000,1.500000) -- (5.500000,1.500000) -- (5.500000,4.500000);%

% Filling triangle A A' D
\fill (1.500000,1.500000) -- (3.000000,1.500000) -- (3.000000,4.500000);%

% Changing color 0 0 0
\definecolor{r0g0b0}{rgb}{0.000000,0.000000,0.000000}%
\color{r0g0b0}% 

% Drawing segment dd bb
\draw [line width=0.016cm] (2.250000,3.000000) -- (5.750000,3.000000);%

% Marking point s
\draw (4.000000,3.000000) node [anchor=south] { $s$ };%

% Drawing segment A B
\draw [line width=0.032cm] (1.540000,1.500000) -- (5.960000,1.500000);%

% Drawing segment B C
\draw [line width=0.032cm] (5.993424,1.539456) -- (5.506576,4.460544);%

% Drawing segment C D
\draw [line width=0.032cm] (5.460000,4.500000) -- (3.040000,4.500000);%

% Drawing segment A D
\draw [line width=0.032cm] (1.517889,1.535777) -- (2.982111,4.464223);%

% Marking point A by circle
\draw [line width=0.032cm] (1.500000,1.500000) circle (0.040000);%
\draw (1.530000,1.530000) node [anchor=north east] { $A$ };%

% Marking point B by circle
\draw [line width=0.032cm] (6.000000,1.500000) circle (0.040000);%
\draw (5.970000,1.530000) node [anchor=north west] { $B$ };%

% Marking point C by circle
\draw [line width=0.032cm] (5.500000,4.500000) circle (0.040000);%
\draw (5.470000,4.470000) node [anchor=south west] { $C$ };%

% Marking point D by circle
\draw [line width=0.032cm] (3.000000,4.500000) circle (0.040000);%
\draw (3.030000,4.470000) node [anchor=south east] { $D$ };%

% Marking point a
\draw (3.750000,1.500000) node [anchor=north] { $a$ };%

% Marking point b
\draw (5.750000,3.000000) node [anchor=west] { $b$ };%

% Marking point c
\draw (4.250000,4.500000) node [anchor=south] { $c$ };%

% Marking point d
\draw (2.250000,3.000000) node [anchor=east] { $d$ };%
\color{black}
}
\end{tikzpicture}
